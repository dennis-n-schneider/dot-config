snippet #! "Shebang"
	\iffalse; /usr/bin/env pdflatex $0 && exit # \fi

snippet frm "Create Beamer-Frame"
	\begin{frame}{$1}{$2}
		{$3}
	\end{frame}

snippet -> "Right Arrow"
	$\rightarrow$

snippet # "Section"
	\section{$1}

snippet ## "Subsection"
	\subsection{$1}

snippet ### "Subsubsection"
	\subsubsection{$1}
