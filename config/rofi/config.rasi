configuration {
    matching: "fuzzy";
    modi: ["run", "window"];
    line-margin: 10;
    font: "Hack Nerd Font Mono 9";
    show-icons: true;
    icon-theme: "Adwaita";
    terminal: "kitty";
    drun-display-format: "{icon} ";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-run: " 󰍉";
    display-window: " ";
    display-clipboard: " 󰨸";
}

@theme "~/.local/share/rofi/themes/dracula.rasi"
