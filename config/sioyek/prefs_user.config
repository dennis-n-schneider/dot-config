# Should be done by package-manager.
check_for_updates_on_startup 0
should_launch_new_window 1
# horizontal_move_amount -1
super_fast_search 1
prerendered_page_count 10
fit_to_page_width_ratio 0.9

new_command _count_words bash /home/dns/.config/sioyek/count_words_in_pdf.sh %{file_path}

new_command _add_text python -m sioyek.add_text "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" "%{selected_rect}" "%{command_text}"

new_command _save_paper bash /home/dns/.config/sioyek/rename_paper.sh %{file_path}

